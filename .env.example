# Copy this file to .env or run `pnpm setup:env`.
# Never commit real passwords or secrets.
DATABASE_URI=postgresql://USER:PASSWORD@localhost:5432/writers_circle
PAYLOAD_SECRET=generate-with-pnpm-setup-env

# Optional Phase 4 provider settings. Never commit a real token.
WECHAT_SEARCH_API_BASE_URL=https://api.justoneapi.com
WECHAT_SEARCH_API_TOKEN=replace-with-provider-token
