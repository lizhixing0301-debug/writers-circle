# Copy this file to .env.docker. Never commit the copied file.
# Use a long, unique password and secret that you keep privately.
POSTGRES_PASSWORD=replace-with-a-long-private-database-password
PAYLOAD_SECRET=replace-with-a-long-private-payload-secret

# Optional: leave both blank unless the WeChat search service is configured.
WECHAT_SEARCH_API_BASE_URL=
WECHAT_SEARCH_API_TOKEN=

# Optional: change only when port 3000 is already occupied.
APP_PORT=3000
